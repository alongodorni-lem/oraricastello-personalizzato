# Planyo (stesse credenziali del backend prenotazioni)
PLANYO_API_KEY=
PLANYO_SITE_ID=8895

# Lista D da CSV: URL report Planyo (es. show-admin-report.php?calendar=...&download=default&shsec=...)
# Se impostato, Lista D viene caricata dal CSV invece che dall'API. Il token shsec può scadere.
# PLANYO_LISTD_CSV_URL=

# Mesi lookback Planyo (default 18). Imposta 12 per preview più veloce se timeout su Render
# PLANYO_MONTHS_LOOKBACK=12

# Privacy (tab PRIVACY): dopo remove_user, se necessario elimina le prenotazioni trovate e ritenta remove_user.
# Imposta true per NON toccare le prenotazioni (solo tentativo remove_user / metodi legacy).
# PLANYO_PRIVACY_SKIP_RESERVATION_DELETE=true
# Legacy: forzava la cancellazione prenotazioni; oggi la cascata è attiva di default se SKIP non è true.
# PLANYO_PRIVACY_ALLOW_RESERVATION_DELETE=true

# Mailchimp - API key con datacenter (es. xxxxxxxx-us21)
MAILCHIMP_API_KEY=
MAILCHIMP_CAMPAIGN_ID=

# Smshosting - da area riservata > Gestione sicurezza API
SMSHOSTING_AUTH_KEY=
SMSHOSTING_AUTH_SECRET=
# Mittente alfanumerico (max 11 caratteri) - es. grottanatal
# SMSHOSTING_USE_ALIAS=true per usarlo, altrimenti mittente numerico
# SMSHOSTING_FROM=
# SMSHOSTING_USE_ALIAS=

# Resend - per Newsletter EMAIL (invio email personalizzate)
RESEND_API_KEY=
EMAIL_FROM="Grotta di Babbo Natale <news@updates.grottadibabbonatale.it>"
# Opzionale: indirizzo risposte (se vuoto usa mailbox del from)
# EMAIL_REPLY_TO=
# Limiti/coda invio email:
# - EMAIL_MAX_PER_DAY=0 => nessun blocco giornaliero applicativo (consigliato con Resend)
# - Imposta un numero > 0 solo se vuoi un guard-rail interno.
EMAIL_MAX_PER_DAY=0
# Massimo destinatari per singolo run API (/api/email/send)
EMAIL_MAX_PER_RUN=500
# Batch Resend (max 100 per request) e concorrenza batch in parallelo
RESEND_BATCH_SIZE=100
RESEND_BATCH_CONCURRENCY=2

# Sicurezza interfaccia web: se impostati, richiede login (Basic Auth)
# NEWSLETTER_SMS_USER=
# NEWSLETTER_SMS_PASSWORD=

# Opzionale: da riga di comando
# node index.js --campaign=abc123     # singola campagna
# node index.js --last=2               # ultime 2 campagne inviate

